# Actual input handlers, real resources, fixed host clock. No gameplay state injection.
menu main
menu-capture main
button new
menu create
button class-1
name automated
button create
level Town 0
frames 3
capture town_initial
walk 3 0
still
frames 2
capture town_walked
key I
inventory open
unequip WEAPON
frames 1
capture unarmed
equip WEAPON
frames 1
capture rearmed
key I
inventory closed
# Panel interplay (setOpen family integration): K/J must open through the
# shared flag machine, ESC must close; a desync fails the verbs below.
key K
inventory open
key ESC
inventory closed
key J
inventory open
key ESC
inventory closed
resize 800 450
frames 3
capture town_resized
key ESC
menu pause
dt 0.1
frames 5
button resume
menu playing
frames 5
dt 0
frames 2
capture before_exit
key ESC
menu pause
dt 0.1
frames 5
button exit-game
menu main
button exit
